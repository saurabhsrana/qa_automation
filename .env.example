# Copy to .env (gitignored) and fill in real values. Never commit .env.

# Environment selector: dev | qa | uat (default qa when unset — see scripts/run-playwright.js)
# TEST_ENV=qa

# Loyalty base URL override (optional — logs a startup warning when it differs from the env default)
# BASE_URL=https://your-app.example.com

# OCE (kept for src/config / oceAuth — not used by welcome/completeprofile)
OCE_BASE_URL=
OCE_USERNAME=
OCE_PASSWORD=
OCE_PRACTICE=Pleasanton Dermatology
OCE_LOCATION=Pleasanton - CA

# Test OTP override (default per env is otp in src/config/environments/{env}.config.ts)
# QA_TEST_OTP=your-harness-otp

# Convex (enrollment tests only — completeprofile.spec.ts)
# Local: run `npx convex login` once; CLI uses your session + --deployment below.
# CI / scripts: env-specific deploy keys (mapped to CONVEX_DEPLOY_KEY for the CLI).
# CONVEX_DEPLOY_KEY_QA=
# CONVEX_DEPLOY_KEY_UAT=
# Optional fallback if the env-specific key is unset:
# CONVEX_DEPLOY_KEY=
# Optional override of convexDeployment in env config (dashboard deployment slug):
# CONVEX_DEPLOYMENT=industrious-trout-712

# Playwright / browser
BROWSER=chromium
PARALLEL_WORKERS=4
HEADLESS=true
# HEADED=true
